# FreeStack .env — copy to .env and fill in. Generate secrets with:
#   openssl rand -hex 32        # hex secrets/keys
#   openssl rand -base64 48     # admin tokens
# Never commit .env to git.

TZ=America/Vancouver

# --- postgres superuser (used only at init + admin) ---
POSTGRES_USER=freestack
POSTGRES_PASSWORD=CHANGE_ME__openssl_rand_hex_32
POSTGRES_DB=freestack

# --- app database passwords (least-privilege users, created by initdb script) ---
N8N_DB_PASSWORD=CHANGE_ME__openssl_rand_hex_32
AUTHENTIK_DB_PASSWORD=CHANGE_ME__openssl_rand_hex_32

# --- shared infra passwords (security: required since 2026-10-05 review) ---
# redis is shared by authentik (db 0) + infisical (db 2); mongo backs infisical.
# Hex-only: both get embedded in URLs, and hex never needs URL-encoding.
REDIS_PASSWORD=CHANGE_ME__openssl_rand_hex_32
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME__openssl_rand_hex_32

# --- ai-router (Cloudflare Worker) ---
# Bearer token every caller sends as: Authorization: Bearer <ROUTER_KEY>
ROUTER_KEY=CHANGE_ME__openssl_rand_hex_32

# --- n8n ---
N8N_ENCRYPTION_KEY=CHANGE_ME__openssl_rand_hex_32
N8N_HOST=localhost              # set to your domain/IP when exposing (e.g. n8n.example.com)
N8N_PROTOCOL=http               # https once behind Pangolin/Tailscale + TLS

# --- authentik ---
AUTHENTIK_SECRET_KEY=CHANGE_ME__openssl_rand_hex_32

# --- infisical (full mode) ---
INFISICAL_ENCRYPTION_KEY=CHANGE_ME__openssl_rand_hex_32
INFISICAL_JWT_SIGNUP_SECRET=CHANGE_ME__openssl_rand_hex_32
INFISICAL_JWT_REFRESH_SECRET=CHANGE_ME__openssl_rand_hex_32
INFISICAL_SITE_URL=http://localhost:8080

# --- surrealdb ---
SURREAL_PASS=CHANGE_ME__openssl_rand_hex_32

# --- searxng ---
SEARXNG_BASE_URL=http://localhost:8888/
SEARXNG_INSTANCE_NAME=freestack
# SEARXNG_SECRET_KEY is set inside ./searxng/settings.yml, NOT here (see DEPLOY.md)

# --- vaultwarden (slim mode only — uncomment service in compose first) ---
# VAULTWARDEN_DOMAIN=http://localhost:8081
# VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME__openssl_rand_base64_48

# --- cloudflare tunnel (opt-in, profile: tunnel — see cloudflare-tunnel.md) ---
# Token from Zero Trust dashboard → Networks → Tunnels → freestack.
# Secret: treat like a password, never paste in chat.
# CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME__tunnel_token_from_dashboard
